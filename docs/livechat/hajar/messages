response = Map();
msg = message.get("text");
companyName = "شركة هجر للاستقدام";
webUrl = "https://hajar.sa";
apiUrl = "https://hajar.sa/api";
afterOptions = { "القائمة الرئيسية", "متابعة طلب", "إنهاء"};
mainOptions = { "طلب استقدام", "تأجير", "نقل كفالة", "متابعة طلب", "شكوى", "اتصال", "إنهاء"};
welcomeReplies = {
    "حياكم وبياكم في موقع شركة هجر للاستقدام ✨",
    "نفرح بزيارتكم، ونسعد بخدمتكم على أكمل وجه.",
    "وش حاب تسوّي اليوم؟ اختر الخدمة المناسبة من القائمة 😊"
};
if (!msg.isNull()) {
    response.put("action", "context");
    if (msg.containsIgnoreCase("انهاء") || msg.containsIgnoreCase("إنهاء") || msg.containsIgnoreCase("اغلاق") || msg.containsIgnoreCase("إغلاق")) {
        response.put("action", "end");
        response.put("replies", {
            "شكراً لتواصلك مع " + companyName + ".",
            "يسعدنا خدمتك دائماً."
        });
        return response;
    }
    if (msg.containsIgnoreCase("الرئيسية") || msg.containsIgnoreCase("القائمة الرئيسية")) {
        response.put("action", "reply");
        response.put("replies", welcomeReplies);
        response.put("input", { "type": "select", "options": mainOptions });
        return response;
    }
    if (msg.containsIgnoreCase("استقدام")) {
        response.put("context_id", "service_estqdam");
        optionList = Collection();
        optionValues = Collection();
        try {
            data_info = invokeurl
            [
                url : apiUrl + "/nationalites"
                type: GET
                headers: { "Content-Type": "application/json" }
            ];
            nationalities = data_info.get("data");
            if (nationalities != null) {
                for each nat_key in nationalities.keys()
                {
                    optionList.insert(nat_key);
                    optionValues.insert(nationalities.get(nat_key));
                }
            }
        }
        catch (e) {
        }
        optionList.insert("عرض جميع الجنسيات");
        optionValues.insert("all");
        optionList.insert("القائمة الرئيسية");
        optionValues.insert("القائمة الرئيسية");
        optionList.insert("إنهاء");
        optionValues.insert("إنهاء");
        question = { "name": "new_request", "replies": { "اختر الجنسية:"}, "input": { "type": "select", "options": optionList, "values": optionValues } };
        response.put("questions", { question });
        return response;
    }
    if (msg.containsIgnoreCase("تأجير") || msg.containsIgnoreCase("تاجير") || msg.containsIgnoreCase("ايجار") || msg.containsIgnoreCase("إيجار")) {
        response.put("action", "reply");
        url = webUrl + "/all-workers?type=egar";
        question = { "type": "links", "text": "المتاح لخدمة التأجير:", "links": {{ "url": url, "text": "عرض المتاح" }} };
        response.put("replies", { question });
        response.put("input", { "type": "select", "options": afterOptions });
        return response;
    }
    if (msg.containsIgnoreCase("نقل")) {
        response.put("action", "reply");
        url = webUrl + "/all-workers?type=transfer";
        question = { "type": "links", "text": "المتاح لخدمة نقل كفالة:", "links": {{ "url": url, "text": "عرض المتاح" }} };
        response.put("replies", { question });
        response.put("input", { "type": "select", "options": afterOptions });
        return response;
    }
    if (msg.containsIgnoreCase("متابعة")) {
        response.put("context_id", "help");
        question = { "name": "contract_reference", "replies": { "أدخل رقم الجواز أو الهوية أو عقد مساند أو التأشيرة:"}, "input": { "type": "name", "placeholder": "رقم المتابعة" } };
        response.put("questions", { question });
        return response;
    }
    if (msg.containsIgnoreCase("شكوى") || msg.containsIgnoreCase("شكوي")) {
        response.put("context_id", "complaints");
        questions = Collection();
        questions.insert({ "name": "complaintUserName", "replies": { "اكتب اسمك:"}, "input": { "type": "name", "placeholder": "الاسم" } });
        questions.insert({ "name": "complaintUserDetails", "replies": { "اكتب تفاصيل الشكوى:"}, "input": { "type": "name", "placeholder": "التفاصيل" } });
        response.put("questions", questions);
        return response;
    }
    if (msg.containsIgnoreCase("اتصال")) {
        response.put("context_id", "call_request");
        questions = Collection();
        questions.insert({ "name": "callUserName", "replies": { "اكتب اسمك:"}, "input": { "type": "name", "placeholder": "الاسم" } });
        response.put("questions", questions);
        return response;
    }
    response.put("action", "reply");
    response.put("replies", welcomeReplies);
    response.put("input", { "type": "select", "options": mainOptions });
    return response;
}
return response;
