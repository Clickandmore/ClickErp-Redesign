response = Map();
info answers;
companyName = "شركة هجر للاستقدام";
webUrl = "https://hajar.sa";
apiUrl = "https://hajar.sa/api";
mainOptions = {"طلب استقدام جديد","متابعة أو دعم","خدمة العملاء"};
supportOptions = {"متابعة طلب سابق","الدعم المباشر","القائمة الرئيسية"};
branchOptions = {"فرع الرياض","فرع الأحساء"};
welcomeText = "حياكم وبياكم في موقع شركة هجر للاستقدام ✨\nنفرح بزيارتكم، ونسعد بخدمتكم على أكمل وجه.\n\nوش حاب تسوّي اليوم؟\nحدد الخيار اللي يناسبك خلنا نخدمك بأفضل شكل 😊";
nationalities = Map();
nationalities_keys = Collection();
nationalities_values = Collection();
try
{
	data_info = invokeurl
	[
		url :apiUrl + "/nationalites"
		type :GET
		headers:{"Content-Type":"application/json"}
	];
	nationalities = data_info.get('data');
	if(nationalities != null)
	{
		nationalities_keys = nationalities.keys();
		nationalities_values = nationalities.values();
	}
}
catch (e)
{
	nationalities = Map();
}
response.put("action","context");
response.put("context_id",context_id);
if(context_id.equals("service_estqdam") || context_id.equals("new_order") || context_id.equals("service_estqdam_riyadh") || context_id.equals("service_estqdam_ahsa") || context_id.equals("branch_services_riyadh") || context_id.equals("branch_services_ahsa"))
{
	branchName = "فرع الرياض";
	if(context_id.equals("service_estqdam_ahsa") || context_id.equals("branch_services_ahsa"))
	{
		branchName = "فرع الأحساء";
	}
	if(answers.containsKey("branch"))
	{
		branchName = answers.get("branch").get("text");
	}
	if(branchName.containsIgnoreCase("انهاء") || branchName.containsIgnoreCase("إنهاء"))
	{
		response.put("action","end");
		response.put("replies",{"شكراً لتواصلك مع " + companyName + ".\nيسعدنا خدمتك دائماً."});
		return response;
	}
	if(branchName.containsIgnoreCase("الرئيسية") || branchName.containsIgnoreCase("القائمة الرئيسية"))
	{
		response.put("action","reply");
		response.put("replies",{welcomeText});
		response.put("input",{"type":"select","options":mainOptions});
		return response;
	}
	branchCode = "riyadh";
	if(branchName.containsIgnoreCase("الأحساء") || branchName.containsIgnoreCase("الاحساء") || branchName.containsIgnoreCase("أحساء") || branchName.containsIgnoreCase("احساء"))
	{
		branchCode = "ahsa";
	}
	if(!answers.containsKey("new_request"))
	{
		optionList = Collection();
		if(nationalities != null)
		{
			try
			{
				for each  nat_key in nationalities.keys()
				{
					optionList.insert(nat_key);
				}
			}
			catch (e)
			{
			}
		}
		if(optionList.size() == 0)
		{
			response.put("action","reply");
			url = webUrl + "/all-workers?type=estqdam&branch=" + branchCode;
			question = {"type":"links","text":"نفتح لك السير الذاتية المتاحة مباشرة، ويمكنك اختيار العاملة المناسبة وإكمال طلب الاستقدام:","links":{{"url":url,"text":"ابدأ طلب الاستقدام"}}};
			response.put("replies",{question});
			response.put("input",{"type":"select","options":mainOptions});
			return response;
		}
		optionList.insert("عرض جميع الجنسيات");
		question = {"name":"new_request","replies":{"ممتاز، اختر الجنسية المناسبة لعرض السير الذاتية:"},"input":{"type":"select","options":optionList}};
		response.put("questions",{question});
		return response;
	}
	new_request = answers.get("new_request").get("text");
	if(new_request.containsIgnoreCase("انهاء") || new_request.containsIgnoreCase("إنهاء"))
	{
		response.put("action","end");
		response.put("replies",{"شكراً لتواصلك مع " + companyName + ".\nيسعدنا خدمتك دائماً."});
		return response;
	}
	if(new_request.containsIgnoreCase("الرئيسية") || new_request.containsIgnoreCase("القائمة الرئيسية"))
	{
		response.put("action","reply");
		response.put("replies",{welcomeText});
		response.put("input",{"type":"select","options":mainOptions});
		return response;
	}
	if(new_request.containsIgnoreCase("جميع"))
	{
		url = webUrl + "/all-workers?type=estqdam&branch=" + branchCode;
	}
	else
	{
		id_nationality = null;
		if(nationalities != null && nationalities.size() > 0 && nationalities_keys.indexOf(new_request) >= 0)
		{
			nationality_index = nationalities_keys.indexOf(new_request);
			id_nationality = nationalities_values.get(nationality_index);
		}
		if(id_nationality == null || id_nationality == "")
		{
			url = webUrl + "/all-workers?type=estqdam&branch=" + branchCode;
		}
		else
		{
			url = webUrl + "/all-workers?type=estqdam&branch=" + branchCode + "&nationality_id=" + id_nationality;
		}
	}
	response.put("action","reply");
	question = {"type":"links","text":"تفضل، اختر السيرة الذاتية المناسبة ثم أكمل طلب الاستقدام:","links":{{"url":url,"text":"ابدأ طلب الاستقدام"}}};
	response.put("replies",{question});
	response.put("input",{"type":"select","options":mainOptions});
	return response;
}
else if(context_id.equals("support"))
{
	support_request = answers.get("support_request").get("text");
	if(support_request.containsIgnoreCase("الرئيسية") || support_request.containsIgnoreCase("القائمة الرئيسية"))
	{
		response.put("action","reply");
		response.put("replies",{welcomeText});
		response.put("input",{"type":"select","options":mainOptions});
		return response;
	}
	if(support_request.containsIgnoreCase("متابعة"))
	{
		response.put("context_id","help");
		question = {"name":"contract_reference","replies":{"تمام، أدخل رقم الجواز أو الهوية أو عقد مساند أو التأشيرة:"},"input":{"type":"name","placeholder":"رقم المتابعة"}};
		response.put("questions",{question});
		return response;
	}
	staffLinks = Collection();
	try
	{
		data_info = invokeurl
		[
			url :apiUrl + "/all_staff"
			type :GET
			headers:{"Content-Type":"application/json"}
		];
		staffs = data_info.get('data');
		if(staffs != null && staffs.size() > 0)
		{
			staff_keys = staffs.keys();
			for each  staff_name in staff_keys
			{
				staff_phone = staffs.get(staff_name);
				if(staff_phone != null && staff_phone != "")
				{
					staffLinks.insert({"url":"https://wa.me/" + staff_phone,"text":staff_name});
				}
			}
		}
	}
	catch (e)
	{
		staffLinks = Collection();
	}
	if(staffLinks.size() > 0)
	{
		response.put("action","reply");
		question = {"type":"links","text":"اختر ممثل خدمة العملاء للتواصل عبر واتساب:","links":staffLinks};
		response.put("replies",{question});
		response.put("input",{"type":"select","options":mainOptions});
		return response;
	}
	response.put("action","forward");
	response.put("replies",{"جاري تحويلك إلى أحد موظفي خدمة العملاء."});
	return response;
}
else if(context_id.equals("help"))
{
	if(!answers.containsKey("contract_reference"))
	{
		question = {"name":"contract_reference","replies":{"أدخل رقم الجواز أو الهوية أو عقد مساند أو التأشيرة:"},"input":{"type":"name","placeholder":"رقم المتابعة"}};
		response.put("questions",{question});
		return response;
	}
	contract_reference = answers.get("contract_reference").get("text");
	if(contract_reference.containsIgnoreCase("الرئيسية") || contract_reference.containsIgnoreCase("القائمة الرئيسية"))
	{
		response.put("action","reply");
		response.put("replies",{welcomeText});
		response.put("input",{"type":"select","options":mainOptions});
		return response;
	}
	if(contract_reference.containsIgnoreCase("انهاء") || contract_reference.containsIgnoreCase("إنهاء"))
	{
		response.put("action","end");
		response.put("replies",{"شكراً لتواصلك مع " + companyName + ".\nيسعدنا خدمتك دائماً."});
		return response;
	}
	contract_data = null;
	try
	{
		contract_data = invokeurl
		[
			url :apiUrl + "/contract_status"
			type :POST
			parameters:{'search_value':contract_reference}
			headers:{"Content-Type":"application/json"}
		];
	}
	catch (e)
	{
		contract_data = null;
	}
	if(contract_data != null && contract_data.get('status') == 1)
	{
		response.put("action","reply");
		response.put("replies",{contract_data.get('data')});
		response.put("input",{"type":"select","options":mainOptions});
		return response;
	}
	question = {"name":"contract_reference","replies":{"لم نتمكن من العثور على الطلب. تأكد من الرقم أو اختر الدعم المباشر من القائمة."},"input":{"type":"name","placeholder":"رقم المتابعة"}};
	response.put("questions",{question});
	return response;
}
else
{
	response.put("action","reply");
	response.put("replies",{welcomeText});
	response.put("input",{"type":"select","options":mainOptions});
	return response;
}
return response;
