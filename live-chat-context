	{
		question = {"name":"contract_reference","replies":{"تعذر الاستعلام عن حالة العقد حاليا.","يمكنك إعادة إدخال الرقم بعد قليل أو كتابة الصفحة الرئيسية للرجوع"},"input":{"type":"name","placeholder":"ادخل رقم الجواز أو الهوية أو رقم العقد أو رقم التأشيرة"}};
