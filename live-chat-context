			return response;
		}
		else if(complaints.equalsIgnoreCase("خدمة مقيمة") || complaints.equalsIgnoreCase("طلب شهري") || complaints.equalsIgnoreCase("الطلب الشهري") || complaints.equalsIgnoreCase("التأجير") || complaints.equalsIgnoreCase("تأجير") || complaints.equalsIgnoreCase("ايجار") || complaints.equalsIgnoreCase("إيجار"))
		{
